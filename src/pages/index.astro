---
import BaseLayout from '../layouts/BaseLayout.astro';

const tocSections = [
  {
    title: "Intro",
    links: [
      { title: "About me", href: "/about-me", description: "Background, location, family, interests" },
      { title: "Work approach & Skills", href: "/work-approach", description: "Design philosophy, core expertise, and T-shape of skills" },
      { title: "Experience & education", href: "/experience-education", description: "23-year career timeline and academic background" },
    ]
  },
  {
    title: "Case Studies",
    links: [
      { title: "Case Studies Overview", href: "/case-studies", description: "Collection of 5 enterprise & digital product case studies" }
    ]
  },
  {
    title: "Contact info",
    links: [
      { title: "Contact info", href: "/contact", description: "Email, phone number, and LinkedIn connection" }
    ]
  }
];
---

<BaseLayout title="Harri Kilpiö | Portfolio of Experience" description="Designer & Design Engineer Portfolio of Experience | Fall 2026">
  <section class="container hero-container" aria-label="Introduction">
    <div class="hero-badge">
      <span class="badge badge--experienced">Available for Opportunities</span>
      <span class="hero-subtext">Portfolio of Experience | Fall 2026</span>
    </div>
    
    <h1 class="hero-title">
      Designer & <span class="text-accent">Design Engineer</span>
    </h1>
    
    <p class="hero-lead">
      Bridging the human side of service design with the technical craft of modern frontend engineering, design systems, and accessible web experiences.
    </p>

    <div class="cta-row">
      <a href="/case-studies" class="btn btn--primary">View Case Studies</a>
      <a href="/work-approach" class="btn btn--secondary">Work Approach</a>
    </div>
  </section>

  <section class="container toc-section" aria-labelledby="toc-heading">
    <h2 id="toc-heading" class="section-heading">Table of Contents</h2>
    
    <div class="toc-grid">
      {tocSections.map((section) => (
        <div class="toc-group">
          <h3 class="toc-group-title">{section.title}</h3>
          <div class="toc-cards">
            {section.links.map((link) => (
              <a href={link.href} class="card toc-card">
                <div class="toc-card-header">
                  <span class="toc-card-title">{link.title}</span>
                  <span class="toc-card-arrow" aria-hidden="true">&rarr;</span>
                </div>
                <p class="toc-card-desc">{link.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>

<style>
  .hero-container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .hero-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-subtext {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .hero-title {
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .text-accent {
    color: var(--color-accent);
  }

  .hero-lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 680px;
    margin-bottom: var(--space-8);
  }

  .cta-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn--primary {
    background-color: var(--color-text-primary);
    color: var(--color-bg);
  }

  .btn--primary:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-bg);
    text-decoration: none;
  }

  .btn--secondary {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
  }

  .btn--secondary:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .toc-section {
    padding-top: var(--space-12);
  }

  .section-heading {
    margin-bottom: var(--space-6);
  }

  .toc-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .toc-group-title {
    font-size: var(--font-size-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .toc-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
  }

  .toc-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .toc-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .toc-card-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .toc-card-arrow {
    color: var(--color-text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .toc-card:hover .toc-card-arrow {
    color: var(--color-accent);
    transform: translateX(4px);
  }

  .toc-card-desc {
    font-size: var(--font-size-xs);
    color: var(--color-text-secondary);
    margin: 0;
  }

</style>
